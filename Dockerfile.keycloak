# Stage 1: React + Vite projesini derleyip Keycloakify teması (.jar) üretme
FROM node:20-slim AS theme-builder
WORKDIR /workspace/frontend/app

# Keycloakify, .jar paketleme adımında (build-keycloak-theme) arka planda
# bir Maven projesi oluşturup `mvn package` çalıştırıyor — bu yüzden JDK + Maven şart.
# Kaynak koddan bağımsız olduğu için erken layer'a koyup Docker cache'inden faydalanıyoruz.
RUN apt-get update && \
    apt-get install -y --no-install-recommends maven openjdk-17-jdk-headless && \
    rm -rf /var/lib/apt/lists/*

# Bağımlılık tanımlarını kopyala (layer caching için ayrı adım)
COPY frontend/app/package*.json ./

# postinstall (keycloakify sync-extensions) henüz src/ yokken çalışamaz,
# bu yüzden şimdilik atlıyoruz — asıl kaynak kod kopyalandıktan sonra manuel tetikleyeceğiz
RUN npm ci --ignore-scripts

# Kaynak kodları kopyala
COPY frontend/app/ ./

# Artık src/ mevcut, postinstall'ın yapması gerekeni elle çalıştır
RUN npx keycloakify sync-extensions

# Keycloakify build işlemini çalıştır (esbuild burada native binary'sini kullanacak, Maven da .jar paketleme için burada devreye giriyor)
RUN npm run build-keycloak-theme

# Stage 2: Keycloak 26.5.5 tabanlı Custom Image
FROM quay.io/keycloak/keycloak:26.5.5 AS runner

COPY --from=theme-builder /workspace/frontend/app/dist_keycloak/*.jar /opt/keycloak/providers/

# Build-time (persisted) ayarlar — kc.sh build'den ÖNCE set edilmeli
ENV KC_DB=postgres
ENV KC_HEALTH_ENABLED=true
ENV KC_METRICS_ENABLED=true

RUN /opt/keycloak/bin/kc.sh build

ENTRYPOINT ["/opt/keycloak/bin/kc.sh"]