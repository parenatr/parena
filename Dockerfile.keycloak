# Stage 1: React + Vite projesini derleyip Keycloakify teması (.jar) üretme
FROM node:20-slim AS theme-builder
WORKDIR /workspace/frontend/app

# Bağımlılık tanımlarını kopyala (layer caching için ayrı adım)
COPY frontend/app/package*.json ./

# postinstall (keycloakify sync-extensions) henüz src/ yokken çalışamaz,
# bu yüzden şimdilik atlıyoruz — asıl kaynak kod kopyalandıktan sonra manuel tetikleyeceğiz
RUN npm ci --ignore-scripts

# Kaynak kodları kopyala
COPY frontend/app/ ./

# Artık src/ mevcut, postinstall'ın yapması gerekeni elle çalıştır
RUN npx keycloakify sync-extensions

# Keycloakify build işlemini çalıştır (esbuild burada native binary'sini kullanacak)
RUN npm run build-keycloak-theme

# Stage 2: Keycloak 26.5.5 tabanlı Custom Image
FROM quay.io/keycloak/keycloak:26.5.5 AS runner

COPY --from=theme-builder /workspace/frontend/app/dist_keycloak/*.jar /opt/keycloak/providers/

RUN /opt/keycloak/bin/kc.sh build

ENTRYPOINT ["/opt/keycloak/bin/kc.sh", "start", "--optimized"]